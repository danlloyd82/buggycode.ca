---
import Base from '../layouts/Base.astro';
import BugField from '../components/BugField.astro';
import ConsoleFrame from '../components/ConsoleFrame.astro';

const tech = ['Qt', 'C++', 'Desktop'];

const modes = [
    {
        label: 'Mini mode',
        src: '/qtronic/mini-mode.png',
        width: 352,
        height: 127,
        alt: 'Qtronic in mini mode: a compact strip with the track name, transport buttons, a seek bar and a volume slider in cyan on dark grey.',
        body: 'Collapses the window to a strip — track, transport, seek and volume — small enough to leave parked in a corner.',
    },
    {
        label: 'Taskbar',
        src: '/qtronic/taskbar.png',
        width: 260,
        height: 30,
        alt: "Qtronic's entry in the Windows taskbar, showing the current track name while the window is minimised.",
        body: 'Minimised, it keeps the current track in the taskbar, so the one thing you want from a player is readable without restoring it.',
    },
];

const themes = [
    {
        src: '/qtronic/theme-1.png',
        width: 704,
        height: 254,
        alt: 'Qtronic rendered in an olive military theme, with bright green accents on a dark khaki panel.',
    },
    {
        src: '/qtronic/theme-2.png',
        width: 704,
        height: 254,
        alt: 'Qtronic rendered in a near-black theme with vibrant green accents.',
    },
    {
        src: '/qtronic/theme-3.png',
        width: 704,
        height: 254,
        alt: 'Qtronic rendered in a dark, leather-textured theme with warm orange accents.',
    },
    {
        src: '/qtronic/theme-4.png',
        width: 704,
        height: 254,
        alt: 'Qtronic rendered in a dark purple theme with a dot-matrix readout and bevelled buttons.',
    },
    {
        src: '/qtronic/theme-5.png',
        width: 704,
        height: 254,
        alt: 'Qtronic rendered in a charcoal theme with cyan accents and a soft-glow equaliser.',
    },
    {
        src: '/qtronic/theme-6.png',
        width: 704,
        height: 270,
        alt: 'Qtronic rendered in a dark purple-to-blue gradient theme with neon cyan accents.',
    },
    {
        src: '/qtronic/theme-7.png',
        width: 704,
        height: 270,
        alt: 'Qtronic rendered in a brushed brown metal theme with chunky bevelled buttons and neon green accents.',
    },
    {
        src: '/qtronic/theme-8.png',
        width: 704,
        height: 270,
        alt: 'Qtronic rendered in a charcoal metal theme with a multicolour spectrum and orange accents.',
    },
    {
        src: '/qtronic/theme-9.png',
        width: 704,
        height: 254,
        alt: 'Qtronic rendered in a deep brown theme with bright orange accents and bevelled, glossy controls.',
    },
];

const facts = [
    { label: 'Sources', value: 'Local files · YouTube · Spotify' },
    { label: 'Built with', value: 'Qt and C++' },
    { label: 'Modes', value: 'Window · Mini · Taskbar' },
    { label: 'Visualiser', value: 'projectM + 7 views' },
    { label: 'Themes', value: '22 so far' },
    { label: 'Status', value: 'In development' },
];
---

<Base
    title="Qtronic — every library, one window | buggycode"
    description="Qtronic is a desktop music player that plays your local files, YouTube Music and your Spotify Premium account out of one queue — with a MilkDrop visualiser and 22 built-in themes."
>
    <a class="skip" href="#main">Skip to content</a>

    <BugField />
    <ConsoleFrame homeHref="/" />

    <main id="main" class="article wrap">
        <p class="crumb">
            <a href="/">The shelf</a>
            <span aria-hidden="true">/</span>
            <span class="lcd">QT-03</span>
        </p>

        <header class="head">
            <p class="lcd eyebrow">QT-03 · In development</p>
            <h1 class="title">Qtronic</h1>
            <p class="tagline">Every library, one window.</p>
            <p class="lede">
                A desktop music player for your own files, YouTube Music without the ads, and your Spotify
                Premium account. Three sources, one queue, one window — whichever of them a track happens
                to live in.
            </p>
            <ul class="chips">
                {tech.map((item) => <li class="lcd chip">{item}</li>)}
            </ul>
        </header>

        <figure class="shot">
            <div class="frame">
                <img
                    src="/qtronic/main.jpg"
                    alt="Qtronic's main window: a transport bar with the current track, elapsed time and a blue seek bar along the top, over an embedded Spotify playlist view listing Today's Top Hits."
                    width="1600"
                    height="1106"
                />
            </div>
            <figcaption>Main window in Spotify source mode.</figcaption>
        </figure>

        <figure class="shot">
            <div class="frame">
                <img
                    src="/qtronic/youtube.jpg"
                    alt="Qtronic's main window in YouTube mode: the transport bar with the current track, elapsed time and a green seek bar along the top, over a YouTube Music browse surface with a search box, filter tabs, artist tiles and a list of results."
                    width="1600"
                    height="1266"
                />
            </div>
            <figcaption>Main window in YouTube Music source mode.</figcaption>
        </figure>

        <section class="block">
            <h2 class="section-label lcd">Three ways to hold it</h2>
            <div class="modes">
                {
                    modes.map((mode) => (
                        <figure class="mode">
                            <div class="frame frame--mode" style={`--mode-w: ${mode.width}px`}>
                                <img
                                    src={mode.src}
                                    srcset={`${mode.src} 2x`}
                                    alt={mode.alt}
                                    width={mode.width}
                                    height={mode.height}
                                />
                            </div>
                            <figcaption>
                                <span class="lcd mode-label">{mode.label}</span>
                                {mode.body}
                            </figcaption>
                        </figure>
                    ))
                }
            </div>
        </section>

        <section class="block split">
            <div class="split-media">
                <div class="frame">
                    <img
                        src="/qtronic/visualizer.jpg"
                        alt="The Qtronic visualiser window running a MilkDrop preset: a dense starburst of dark green lines over a murky red and purple background."
                        width="1600"
                        height="900"
                    />
                </div>
            </div>
            <div class="split-copy">
                <h2 class="section-label lcd">Visualiser</h2>
                <h3 class="split-title">Old-school, on purpose</h3>
                <p class="split-body">
                    A separate window or fullscreen that runs MilkDrop visualisations through projectM,
                    with a browser for the thousands of <span class="mono">.milk</span> presets people have
                    made over the years.
                    When you just want the essentials, the titlebar can cycle seven live oscilloscope
                    views (bars, mirrored, LEDs, line, scope, rainbow, and stereo) driven directly by the
                    audio output.
                </p>
            </div>
        </section>

        <section class="block">
            <h2 class="section-label lcd">22 themes so far</h2>
            <p class="block-lede">A few theme examples:</p>
            <ul class="themes">
                {
                    themes.map((theme) => (
                        <li class="theme">
                            <div class="frame frame--theme">
                                <img
                                    src={theme.src}
                                    alt={theme.alt}
                                    width={theme.width}
                                    height={theme.height}
                                />
                            </div>
                        </li>
                    ))
                }
            </ul>
        </section>

        <section class="block story">
            <div class="story-copy">
                <h2 class="section-label lcd">Where it started</h2>
                <p>
                    Qtronic is the second one. The first was Digitronic, a skinnable MP3 player I built in
                    2000 — swappable skins and support for Winamp skins, a spectrum window, a playlist
                    you could drag anything into.
                </p>
                <p>
                    Qtronic is that same idea a quarter of a century later, with the parts that mattered
                    kept: the skinning survived, the spectrum survived, and the sources grew from one to
                    three.
                </p>
            </div>
            <dl class="facts">
                {
                    facts.map((fact) => (
                        <div class="fact">
                            <dt class="lcd fact-label">{fact.label}</dt>
                            <dd class="fact-value">{fact.value}</dd>
                        </div>
                    ))
                }
            </dl>
        </section>

        <p class="back">
            <a class="cta" href="/">Back to the shelf</a>
        </p>
    </main>

    <footer class="foot">
        <div class="wrap foot-inner">
            <p class="lcd">buggycode.ca</p>
            <p class="lcd foot-note">Qtronic is in development. The project page grows as it does.</p>
        </div>
    </footer>
</Base>

<style>
    .skip {
        position: absolute;
        top: -100px;
        left: var(--s2);
        z-index: 100;
        padding: 10px var(--s2);
        background: var(--ink);
        color: var(--ground);
        font-weight: 600;
        text-decoration: none;
        border-radius: var(--r1);
    }

    .skip:focus {
        top: var(--s2);
    }

    .article {
        padding-block: var(--s3) var(--s5);
    }

    /* ---------------------------------------------------------------- crumb */

    .crumb {
        display: flex;
        align-items: center;
        gap: 8px;
        color: var(--ink-faint);
    }

    .crumb a {
        color: var(--ink-dim);
        text-decoration: none;
    }

    .crumb a:hover {
        color: var(--ink);
    }

    /* ----------------------------------------------------------------- head */

    .head {
        margin-top: var(--s3);
        margin-bottom: var(--s4);
    }

    .eyebrow {
        color: var(--gold);
    }

    .title {
        margin-top: var(--s1);
        font-size: clamp(2.5rem, 1.5rem + 4vw, 4rem);
    }

    .tagline {
        margin-top: var(--s1);
        color: var(--gold);
        font-size: 1.25rem;
        font-weight: 500;
    }

    .lede {
        max-width: var(--measure);
        margin-top: var(--s2);
        color: var(--ink-dim);
        font-size: 1.0625rem;
    }

    .chips {
        display: flex;
        flex-wrap: wrap;
        gap: var(--s1);
        margin-top: var(--s3);
    }

    .chip {
        padding: 3px 8px;
        border: 1px solid var(--edge);
        border-radius: var(--r1);
        color: var(--ink-faint);
    }

    /* --------------------------------------------------------------- frames */

    .frame {
        display: grid;
        place-items: center;
        padding: 6px;
        background: #050609;
        border: 1px solid var(--edge);
        border-radius: var(--r2);
        box-shadow: inset 0 3px 18px rgba(0, 0, 0, 0.9);
        overflow: hidden;
    }

    .frame img {
        width: 100%;
        height: auto;
        border-radius: var(--r1);
    }

    .shot {
        margin: 0;
    }

    .shot + .shot {
        margin-top: var(--s4);
    }

    .shot figcaption,
    .mode figcaption {
        max-width: var(--measure);
        margin-top: var(--s2);
        color: var(--ink-faint);
        font-size: 0.9375rem;
    }

    /* --------------------------------------------------------------- blocks */

    .block {
        margin-top: var(--s5);
    }

    .block-lede {
        max-width: var(--measure);
        margin-bottom: var(--s3);
        color: var(--ink-dim);
    }

    /* ---------------------------------------------------------------- modes */

    .modes {
        display: grid;
        grid-template-columns: 1fr;
        gap: var(--s4);
    }

    @media (min-width: 860px) {
        .modes {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: var(--s3);
            align-items: start;
        }
    }

    .mode {
        margin: 0;
    }

    /* The mode captures are 2x (the app runs at devicePixelRatio 2), so their
       width/height attributes carry the logical size, the file is declared 2x,
       and the frame is capped at that logical width (--mode-w, set inline from
       the same value) rather than being filled out to the column. Letting the
       frame take the column is what made mini mode read as zoomed in - a
       352px window stretched to 650. */
    .frame--mode {
        width: fit-content;
        max-width: min(100%, var(--mode-w));
    }

    .frame--mode img {
        width: auto;
        max-width: 100%;
    }

    .mode-label {
        display: block;
        color: var(--gold);
        margin-bottom: 4px;
    }

    /* ---------------------------------------------------------------- split */

    .split {
        display: grid;
        grid-template-columns: 1fr;
        gap: var(--s3);
        align-items: center;
    }

    @media (min-width: 900px) {
        .split {
            grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
            gap: var(--s4);
        }
    }

    .split-title {
        font-size: 1.5rem;
        margin-bottom: var(--s1);
    }

    .split-body {
        max-width: 46ch;
        color: var(--ink-dim);
    }

    .mono {
        font-family: ui-monospace, 'SFMono-Regular', Menlo, monospace;
        font-size: 0.9em;
        color: var(--ink);
    }

    /* --------------------------------------------------------------- themes */

    .themes {
        display: grid;
        grid-template-columns: 1fr;
        gap: var(--s2);
    }

    @media (min-width: 620px) {
        .themes {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @media (min-width: 1000px) {
        .themes {
            grid-template-columns: repeat(3, 1fr);
        }
    }

    .theme {
        margin: 0;
    }

    .frame--theme {
        padding: 0;
    }

    .frame--theme img {
        border-radius: 0;
    }

    /* ---------------------------------------------------------------- story */

    .story {
        display: grid;
        grid-template-columns: 1fr;
        gap: var(--s4);
    }

    @media (min-width: 900px) {
        .story {
            grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
            gap: var(--s5);
            align-items: start;
        }
    }

    .story-copy p {
        max-width: var(--measure);
        color: var(--ink-dim);
    }

    .story-copy p + p {
        margin-top: var(--s2);
    }

    .facts {
        margin: 0;
        border-top: 1px solid var(--edge);
    }

    .fact {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: var(--s2);
        padding-block: 10px;
        border-bottom: 1px solid var(--edge);
    }

    .fact-label {
        color: var(--ink-faint);
    }

    .fact-value {
        margin: 0;
        color: var(--ink);
        font-weight: 500;
        text-align: right;
    }

    /* ----------------------------------------------------------------- back */

    .back {
        margin-top: var(--s5);
    }

    .cta {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        min-height: 48px;
        padding: 0 var(--s3);
        border: 1px solid var(--ink-faint);
        border-radius: var(--r2);
        color: var(--ink);
        font-weight: 600;
        text-decoration: none;
        transition:
            border-color 0.2s var(--ease-out),
            background-color 0.2s var(--ease-out);
    }

    .cta::before {
        content: '';
        width: 7px;
        height: 7px;
        border-left: 2px solid currentColor;
        border-bottom: 2px solid currentColor;
        transform: rotate(45deg) translate(1px, -1px);
    }

    .cta:hover {
        border-color: var(--ink);
        background: var(--shell);
    }

    /* --------------------------------------------------------------- footer */

    .foot {
        border-top: 1px solid var(--edge);
        padding-block: var(--s3);
    }

    .foot-inner {
        display: flex;
        flex-wrap: wrap;
        gap: var(--s2);
        align-items: baseline;
        justify-content: space-between;
        color: var(--ink-faint);
    }

    .foot-note {
        max-width: 40ch;
    }
</style>
