---
const tech = ['Qt', 'C++', 'Desktop'];

const modes = [
    {
        label: 'Mini mode',
        src: '/qtronic/mini-mode.png',
        width: 352,
        height: 127,
        alt: 'Qtronic in mini mode: a compact strip with the track name, transport buttons, a seek bar and a volume slider in cyan on dark grey.',
        body: 'Collapses the window to a strip — track, transport, seek and volume — small enough to leave parked in a corner.',
    },
    {
        label: 'Taskbar',
        src: '/qtronic/taskbar.png',
        width: 260,
        height: 30,
        alt: "Qtronic's entry in the Windows taskbar, showing the current track name while the window is minimised.",
        body: 'Minimised, it keeps the current track in the taskbar, so the one thing you want from a player is readable without restoring it.',
    },
];

const themes = [
    {
        src: '/qtronic/theme-1.png',
        width: 704,
        height: 254,
        alt: 'Qtronic rendered in an olive military theme, with bright green accents on a dark khaki panel.',
    },
    {
        src: '/qtronic/theme-2.png',
        width: 704,
        height: 254,
        alt: 'Qtronic rendered in a near-black theme with vibrant green accents.',
    },
    {
        src: '/qtronic/theme-3.png',
        width: 704,
        height: 254,
        alt: 'Qtronic rendered in a dark, leather-textured theme with warm orange accents.',
    },
    {
        src: '/qtronic/theme-4.png',
        width: 704,
        height: 254,
        alt: 'Qtronic rendered in a dark purple theme with a dot-matrix readout and bevelled buttons.',
    },
    {
        src: '/qtronic/theme-5.png',
        width: 704,
        height: 254,
        alt: 'Qtronic rendered in a charcoal theme with cyan accents and a soft-glow equaliser.',
    },
    {
        src: '/qtronic/theme-6.png',
        width: 704,
        height: 270,
        alt: 'Qtronic rendered in a dark purple-to-blue gradient theme with neon cyan accents.',
    },
    {
        src: '/qtronic/theme-7.png',
        width: 704,
        height: 270,
        alt: 'Qtronic rendered in a brushed brown metal theme with chunky bevelled buttons and neon green accents.',
    },
    {
        src: '/qtronic/theme-8.png',
        width: 704,
        height: 270,
        alt: 'Qtronic rendered in a charcoal metal theme with a multicolour spectrum and orange accents.',
    },
    {
        src: '/qtronic/theme-9.png',
        width: 704,
        height: 254,
        alt: 'Qtronic rendered in a deep brown theme with bright orange accents and bevelled, glossy controls.',
    },
];

const facts = [
    { label: 'Sources', value: 'Local files · YouTube · Spotify' },
    { label: 'Built with', value: 'Qt and C++' },
    { label: 'Modes', value: 'Window · Mini · Taskbar' },
    { label: 'Visualiser', value: 'projectM + 7 views' },
    { label: 'Themes', value: '22 so far' },
    { label: 'Status', value: 'In development' },
];
---

<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Qtronic is a desktop music player for local files, YouTube Music and Spotify, with a MilkDrop visualiser and 22 built-in themes." />
    <meta name="theme-color" content="#17130f" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="/atari/styles.css" />
    <link rel="stylesheet" href="/atari/qtronic.css" />
    <title>Qtronic — Every library, one window | buggycode</title>
</head>
<body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="bug-field" id="bug-field" aria-hidden="true" hidden></div>
    <header class="topbar">
        <a class="brand" href="/"><img class="brand-mark" src="/favicon.svg" alt="" /> buggycode</a>
        <nav aria-label="Main navigation"><a href="/#projects">Projects</a><a href="/#about">About</a></nav>
        <div class="top-actions">
            <p class="score lcd"><span>Squashed</span><strong id="squash-count">000</strong></p>
            <button id="bug-toggle" class="bug-toggle" type="button" aria-pressed="false"><span class="toggle-mark" aria-hidden="true">▶</span><span>Bug hunt</span></button>
        </div>
    </header>

    <main id="main" class="article wrap">
        <p class="crumb">
            <a href="/">The shelf</a>
            <span aria-hidden="true">/</span>
            <span class="lcd">QT-03</span>
        </p>

        <header class="head">
            <p class="lcd eyebrow">QT-03 · In development</p>
            <h1 class="title">Qtronic</h1>
            <p class="tagline">Every library, one window.</p>
            <p class="lede">
                A desktop music player for your own files, YouTube Music without the ads, and your Spotify
                Premium account. Three sources, one queue, one window — whichever of them a track happens
                to live in.
            </p>
            <ul class="chips">
                {tech.map((item) => <li class="lcd chip">{item}</li>)}
            </ul>
        </header>

        <figure class="shot">
            <div class="frame">
                <img
                    src="/qtronic/main.jpg"
                    alt="Qtronic's main window: a transport bar with the current track, elapsed time and a blue seek bar along the top, over an embedded Spotify playlist view listing Today's Top Hits."
                    width="1600"
                    height="1106"
                />
            </div>
            <figcaption>Main window in Spotify source mode.</figcaption>
        </figure>

        <figure class="shot">
            <div class="frame">
                <img
                    src="/qtronic/youtube.jpg"
                    alt="Qtronic's main window in YouTube mode: the transport bar with the current track, elapsed time and a green seek bar along the top, over a YouTube Music browse surface with a search box, filter tabs, artist tiles and a list of results."
                    width="1600"
                    height="1266"
                />
            </div>
            <figcaption>Main window in YouTube Music source mode.</figcaption>
        </figure>

        <section class="block">
            <h2 class="section-label lcd">Three ways to hold it</h2>
            <div class="modes">
                {
                    modes.map((mode) => (
                        <figure class="mode">
                            <div class="frame frame--mode" style={`--mode-w: ${mode.width}px`}>
                                <img
                                    src={mode.src}
                                    srcset={`${mode.src} 2x`}
                                    alt={mode.alt}
                                    width={mode.width}
                                    height={mode.height}
                                />
                            </div>
                            <figcaption>
                                <span class="lcd mode-label">{mode.label}</span>
                                {mode.body}
                            </figcaption>
                        </figure>
                    ))
                }
            </div>
        </section>

        <section class="block split">
            <div class="split-media">
                <div class="frame">
                    <img
                        src="/qtronic/visualizer.jpg"
                        alt="The Qtronic visualiser window running a MilkDrop preset: a dense starburst of dark green lines over a murky red and purple background."
                        width="1600"
                        height="900"
                    />
                </div>
            </div>
            <div class="split-copy">
                <h2 class="section-label lcd">Visualiser</h2>
                <h3 class="split-title">Old-school, on purpose</h3>
                <p class="split-body">
                    A separate window or fullscreen that runs MilkDrop visualisations through projectM,
                    with a browser for the thousands of <span class="mono">.milk</span> presets people have
                    made over the years.
                    When you just want the essentials, the titlebar can cycle seven live oscilloscope
                    views (bars, mirrored, LEDs, line, scope, rainbow, and stereo) driven directly by the
                    audio output.
                </p>
            </div>
        </section>

        <section class="block">
            <h2 class="section-label lcd">22 themes so far</h2>
            <p class="block-lede">A few theme examples:</p>
            <ul class="themes">
                {
                    themes.map((theme) => (
                        <li class="theme">
                            <div class="frame frame--theme">
                                <img
                                    src={theme.src}
                                    alt={theme.alt}
                                    width={theme.width}
                                    height={theme.height}
                                />
                            </div>
                        </li>
                    ))
                }
            </ul>
        </section>

        <section class="block story">
            <div class="story-copy">
                <h2 class="section-label lcd">Where it started</h2>
                <p>
                    Qtronic is the second one. The first was Digitronic, a skinnable MP3 player I built in
                    2000 — swappable skins and support for Winamp skins, a spectrum window, a playlist
                    you could drag anything into.
                </p>
                <p>
                    Qtronic is that same idea a quarter of a century later, with the parts that mattered
                    kept: the skinning survived, the spectrum survived, and the sources grew from one to
                    three.
                </p>
            </div>
            <dl class="facts">
                {
                    facts.map((fact) => (
                        <div class="fact">
                            <dt class="lcd fact-label">{fact.label}</dt>
                            <dd class="fact-value">{fact.value}</dd>
                        </div>
                    ))
                }
            </dl>
        </section>

        <p class="back">
            <a class="cta" href="/">Back to the shelf</a>
        </p>
    </main>

    <footer class="q-footer">
        <div class="wrap q-footer-inner">
            <a class="lcd" href="/#projects">← Back to projects</a>
            <span class="lcd">Qtronic is in development</span>
        </div>
    </footer>
    <script type="module" src="/atari/arcade.js"></script>
</body>
</html>
