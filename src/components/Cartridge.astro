---
import type { Project } from '../data/projects';

interface Props {
    project: Project;
}

const { project } = Astro.props;
const capture = project.captures[0];
---

<article class="cart" data-polarity={project.polarity}>
    <div class="cart-head">
        <span class="lcd cart-code">{project.code}</span>
        <span class="lcd cart-status">{project.status}</span>
    </div>

    <div class:list={['cart-screen', { 'cart-screen--empty': !capture }]}>
        {
            capture ? (
                <img
                    src={capture.src}
                    alt={capture.alt}
                    width="640"
                    height="400"
                    loading="lazy"
                    decoding="async"
                />
            ) : (
                <span class="lcd cart-empty">Screen pending</span>
            )
        }
    </div>

    <h3 class="cart-name">{project.name}</h3>
    <p class="cart-tagline">{project.tagline}</p>
    <p class="cart-desc">{project.description}</p>

    <ul class="chips">
        {project.tech.map((item) => <li class="lcd chip">{item}</li>)}
    </ul>

    <div class="cart-foot">
        {
            project.page ? (
                <a class="cart-link" href={project.page}>
                    <span>{project.pageLabel ?? 'Read the write-up'}</span>
                    <span class="cart-link-mark" aria-hidden="true">
                        →
                    </span>
                </a>
            ) : project.url ? (
                <a class="cart-link" href={project.url} target="_blank" rel="noopener">
                    <span>{project.urlLabel}</span>
                    <span class="cart-link-mark" aria-hidden="true">
                        ↗
                    </span>
                    <span class="visually-hidden">(opens in a new tab)</span>
                </a>
            ) : (
                <p class="lcd cart-pending">No public build yet</p>
            )
        }
    </div>
</article>

<style>
    .cart {
        position: relative;
        display: flex;
        flex-direction: column;
        padding: var(--s3) var(--s3) var(--s3) calc(var(--s3) + 6px);
        background: var(--shell);
        border: 2px solid var(--edge);
        border-radius: var(--r2) var(--r4) var(--r2) var(--r2);
        overflow: hidden;
        transition:
            transform 0.25s var(--ease-out),
            border-color 0.25s var(--ease-out);
    }

    /* The spine. Its colour is the project's polarity, so colour carries
       meaning here rather than decorating the card. */
    .cart::before {
        content: '';
        position: absolute;
        inset: 0 auto 0 0;
        width: 6px;
        background: var(--polarity);
    }

    .cart[data-polarity='cyan'] {
        --polarity: var(--cyan);
    }
    .cart[data-polarity='magenta'] {
        --polarity: var(--magenta);
    }
    .cart[data-polarity='gold'] {
        --polarity: var(--gold);
    }

    .cart:hover,
    .cart:focus-within {
        transform: translateY(-4px);
        border-color: var(--edge-hi);
    }

    .cart-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--s2);
        padding-bottom: var(--s2);
    }

    .cart-code {
        color: var(--polarity);
        font-weight: 700;
    }

    .cart-status {
        color: var(--ink-faint);
    }

    .cart-screen {
        display: grid;
        place-items: center;
        /* 4:3 keeps the captures close to their native shapes. A widescreen
           frame left a lot of dead space around the near-square ones. */
        aspect-ratio: 4 / 3;
        background: #050609;
        border: 1px solid var(--edge);
        border-radius: var(--r1);
        box-shadow: inset 0 3px 16px rgba(0, 0, 0, 0.9);
        overflow: hidden;
    }

    .cart-screen img {
        width: 100%;
        height: 100%;
        /* The captures have genuinely different shapes, so fit rather than
           crop. Letterboxing lands on the dark screen and reads as one. */
        object-fit: contain;
    }

    .cart-empty {
        color: var(--ink-faint);
    }

    .cart-name {
        margin-top: var(--s3);
        font-size: 1.5rem;
    }

    .cart-tagline {
        margin-top: var(--s1);
        color: var(--polarity);
        font-weight: 500;
    }

    .cart-desc {
        margin-top: var(--s2);
        color: var(--ink-dim);
        font-size: 0.9375rem;
        line-height: 1.65;
    }

    .chips {
        display: flex;
        flex-wrap: wrap;
        gap: var(--s1);
        margin-top: var(--s2);
    }

    .chip {
        padding: 3px 8px;
        border: 1px solid var(--edge);
        border-radius: var(--r1);
        color: var(--ink-faint);
    }

    .cart-foot {
        /* Pins the action to the bottom so the buttons line up across
           cards of unequal text length. */
        margin-top: auto;
        padding-top: var(--s3);
    }

    .cart-link {
        display: inline-flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--s2);
        width: 100%;
        min-height: 44px;
        padding: 0 var(--s2);
        border: 1px solid var(--polarity);
        border-radius: var(--r1);
        color: var(--polarity);
        font-weight: 600;
        text-decoration: none;
        transition:
            background-color 0.2s var(--ease-out),
            color 0.2s var(--ease-out);
    }

    .cart-link:hover {
        background: var(--polarity);
        color: #06070a;
    }

    .cart-link-mark {
        font-size: 1.125rem;
        line-height: 1;
    }

    .cart-pending {
        color: var(--ink-faint);
    }
</style>
