---
import { site } from '../data/site';
---

<section class="hero" id="top">
    <div class="wrap">
        <p class="lcd eyebrow">Three cartridges loaded</p>
        <h1 class="hero-title">{site.headline}</h1>
        <p class="hero-intro">{site.intro}</p>
    </div>
</section>

<style>
    .hero {
        padding-block: var(--s4) 0;
    }

    @media (min-width: 768px) {
        .hero {
            padding-block: var(--s5) 0;
        }
    }

    .eyebrow {
        color: var(--cyan);
        margin-bottom: var(--s2);
    }

    .hero-title {
        max-width: 16ch;
        font-size: clamp(2.5rem, 1.25rem + 6vw, 4.5rem);
    }

    .hero-intro {
        max-width: 52ch;
        margin-top: var(--s2);
        color: var(--ink-dim);
        font-size: 1.0625rem;
    }
</style>
